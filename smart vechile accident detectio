# ==================== MAIN SIMULATION ====================
def run_simulation():
    print("="*60)
    print("AEGIS SENTINEL - Accident Detection Simulation")
    print("="*60)
    # Vehicle selection
    print("\nSelect vehicle type:")
    for i, vt in enumerate(VehicleType, 1):
        print(f"  {i}. {vt.value}")
    choice = input("Enter number (1-6, default 2): ").strip()
    try:
        vehicle_type = list(VehicleType)[int(choice)-1] if choice else VehicleType.CAR
    except (ValueError, IndexError):
        vehicle_type = VehicleType.CAR
    # Crash simulation
    crash_input = input("Simulate crash? (y/n, default y): ").strip().lower()
    simulate_crash = crash_input != 'n'
    # Driver responsive?
    resp_input = input("Simulate driver responsive? (y/n, default n): ").strip().lower()
    driver_responsive = resp_input == 'y'
    # Speed of verification (fast-forward or real-time)
    fast = input("Fast-forward verification? (y/n, default y): ").strip().lower()
    fast_forward = fast != 'n'

    # Create components
    sim = SensorSimulator(vehicle_type)
    fusion = SensorFusionEngine()
    verification = VerificationProtocol(window_seconds=5 if fast_forward else VERIFICATION_WINDOW_SECONDS)

    # Phase 1: Normal driving
    print("\n[PHASE 1] Normal driving...")
    normal_readings = []
    for i in range(3):
        data = sim.generate_normal()
        result = fusion.calculate_confidence(data)
        normal_readings.append(data)
        print(f"  t={data.timestamp:.1f}s | Speed={data.gps_speed:.0f} km/h | "
              f"Score={result.confidence_score:.1f} | {result.confidence.value}")

    # Phase 2: Crash
    if simulate_crash:
        print("\n[PHASE 2] CRASH EVENT DETECTED!")
        data = sim.generate_crash()
        result = fusion.calculate_confidence(data)
        print(f"  Impact G-Force: {result.impact_force_g:.1f}G")
        print(f"  Rollover: {'YES' if result.rollover_detected else 'NO'}")
        print(f"  Fire: {'YES' if result.fire_detected else 'NO'}")
        print(f"  Driver State: {result.driver_state.value}")
        print(f"  Confidence Score: {result.confidence_score:.1f}")
        print(f"  Confidence Level: {result.confidence.value}")
        print(f"  Recommendation: {result.recommendation}")

        # Verification if needed
        if result.confidence in [ConfidenceLevel.MEDIUM, ConfidenceLevel.HIGH, ConfidenceLevel.CRITICAL]:
            cancelled, status = verification.verify_driver(driver_responsive, simulated=fast_forward)
            if not cancelled:
                # Dispatch
                dispatcher = EmergencyDispatcher()
                alert = EmergencyAlert(
                    vehicle_id=f"VEH-{random.randint(1000,9999)}",
                    vehicle_type=vehicle_type,
                    location=(random.uniform(35.0, 40.0), random.uniform(-120.0, -115.0)),
                    timestamp=time.time(),
                    confidence=result.confidence,
                    crash_signature=f"Impact {result.impact_force_g:.1f}G, "
                                    f"{'Rollover, ' if result.rollover_detected else ''}"
                                    f"{'Fire detected, ' if result.fire_detected else ''}"
                                    f"{'Airbag deployed' if data.airbag_deployed else 'No airbag'}",
                    occupant_status=result.driver_state.value,
                    battery_status=f"{data.battery_voltage:.1f}V, "
                                   f"{'Thermal event possible' if data.cabin_temperature > 50 else 'Normal'}",
                    notification_targets=[
                        "🚑 Nearest Ambulance",
                        "🏥 Trauma Center",
                        "📱 Emergency Contacts",
                        "🚚 Fleet Control (if applicable)",
                        "📡 PSAP (eCall)",
                    ]
                )
                dispatcher.dispatch(alert)
                # Store summary for PPT
                sim_summary = {
                    'vehicle_type': vehicle_type.value,
                    'confidence_score': result.confidence_score,
                    'confidence_level': result.confidence.value,
                    'impact_g': result.impact_force_g,
                    'rollover': result.rollover_detected,
                    'fire': result.fire_detected,
                    'driver_state': result.driver_state.value,
                    'location': alert.location,
                }
            else:
                print("\n[RESULT] Driver responded - false alarm logged.")
                sim_summary = {
                    'vehicle_type': vehicle_type.value,
                    'confidence_score': result.confidence_score,
                    'confidence_level': result.confidence.value,
                    'impact_g': result.impact_force_g,
                    'rollover': result.rollover_detected,
                    'fire': result.fire_detected,
                    'driver_state': result.driver_state.value,
                    'location': (0,0),
                    'cancelled': True,
                }
        else:
            print("\n[RESULT] Low confidence - event logged only.")
            sim_summary = {
                'vehicle_type': vehicle_type.value,
                'confidence_score': result.confidence_score,
                'confidence_level': result.confidence.value,
                'impact_g': result.impact_force_g,
                'rollover': result.rollover_detected,
                'fire': result.fire_detected,
                'driver_state': result.driver_state.value,
                'location': (0,0),
            }
    else:
        print("\n[RESULT] Normal driving - no crash detected.")
        sim_summary = {
            'vehicle_type': vehicle_type.value,
            'confidence_score': 0,
            'confidence_level': 'LOW',
            'impact_g': 0,
            'rollover': False,
            'fire': False,
            'driver_state': 'ALERT',
            'location': (0,0),
        }
    return sim_summary

# ==================== MAIN ====================
def main():
    # Run simulation
    sim_summary = run_simulation()
    # Ask to generate PPT
    if PPT_AVAILABLE:
        gen_input = input("\nGenerate PowerPoint report? (y/n, default y): ").strip().lower()
        if gen_input != 'n':
            print("\nGenerating PowerPoint report...")
            gen = PresentationGenerator(simulation_summary=sim_summary)
            gen.generate()
        else:
            print("PPT generation skipped.")
    else:
        print("\nNote: python-pptx or matplotlib not installed. Install with: pip install python-pptx matplotlib")

if __name__ == "__main__":
    main()
