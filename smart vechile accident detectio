# ==================== SENSOR SIMULATOR ====================
class SensorSimulator:
    """
    Generates realistic synthetic sensor data for different vehicle types.
    Supports normal driving and crash scenarios.
    """
    def __init__(self, vehicle_type: VehicleType):
        self.vehicle_type = vehicle_type
        self.time = 0.0
        self.speed = random.uniform(40, 80)  # initial speed

    def _generate_normal_dynamics(self):
        """Generate normal driving sensor readings with small noise."""
        self.time += 0.1
        # Smooth speed variation
        self.speed += random.uniform(-2, 2)
        self.speed = max(30, min(120, self.speed))
        return SensorData(
            timestamp=self.time,
            accel_x=random.uniform(-0.3, 0.3),
            accel_y=random.uniform(-0.3, 0.3),
            accel_z=random.uniform(-1.2, -0.8),
            gyro_x=random.uniform(-15, 15),
            gyro_y=random.uniform(-15, 15),
            gyro_z=random.uniform(-15, 15),
            inclination=random.uniform(-15, 15),
            gps_speed=self.speed,
            wheel_speed=self.speed + random.uniform(-2, 2),
            brake_active=random.random() < 0.1,
            steering_angle=random.uniform(-30, 30),
            airbag_deployed=False,
            engine_status=True,
            battery_voltage=13.5 + random.uniform(-0.3, 0.3),
            cabin_temperature=22 + random.uniform(-1, 1),
            smoke_detected=False,
            ear=random.uniform(0.25, 0.35),
            perclos=random.uniform(0.05, 0.2),
            head_pose_pitch=random.uniform(-5, 5),
            head_pose_yaw=random.uniform(-15, 15),
            helmet_impact=False
        )

    def _generate_crash_dynamics(self):
        """Generate severe crash sensor readings."""
        self.time += 0.1
        # High G-force impact
        accel_magnitude = random.uniform(5.0, 12.0)
        accel_x = accel_magnitude * random.uniform(-1, 1)
        accel_y = accel_magnitude * random.uniform(-1, 1)
        accel_z = accel_magnitude * random.uniform(-1, 1)
        # Rapid rotation
        gyro_x = random.uniform(150, 400) * random.choice([-1, 1])
        gyro_y = random.uniform(150, 400) * random.choice([-1, 1])
        gyro_z = random.uniform(150, 400) * random.choice([-1, 1])
        # Vehicle may be overturned
        inclination = random.uniform(45, 180)
        # Speed drops
        self.speed = random.uniform(0, 10)
        # Airbag for enclosed vehicles
        airbag = self.vehicle_type in [VehicleType.CAR, VehicleType.BUS, VehicleType.TRUCK] and random.random() < 0.9
        # Driver state
        unconscious = random.random() < 0.7
        ear = random.uniform(0.0, 0.1) if unconscious else random.uniform(0.2, 0.3)
        perclos = random.uniform(0.8, 1.0) if unconscious else random.uniform(0.1, 0.3)
        return SensorData(
            timestamp=self.time,
            accel_x=accel_x,
            accel_y=accel_y,
            accel_z=accel_z,
            gyro_x=gyro_x,
            gyro_y=gyro_y,
            gyro_z=gyro_z,
            inclination=inclination,
            gps_speed=self.speed,
            wheel_speed=self.speed + random.uniform(-1, 1),
            brake_active=True,
            steering_angle=random.uniform(-90, 90),
            airbag_deployed=airbag,
            engine_status=random.random() < 0.3,
            battery_voltage=random.uniform(9.0, 12.0) if random.random() < 0.5 else 13.0,
            cabin_temperature=random.uniform(30, 60) if random.random() < 0.3 else 25,
            smoke_detected=random.random() < 0.2,
            ear=ear,
            perclos=perclos,
            head_pose_pitch=random.uniform(-30, 30) if unconscious else random.uniform(-10, 10),
            head_pose_yaw=random.uniform(-60, 60),
            helmet_impact=self.vehicle_type == VehicleType.MOTORCYCLE and random.random() < 0.6
        )

    def generate_normal(self) -> SensorData:
        return self._generate_normal_dynamics()

    def generate_crash(self) -> SensorData:
        return self._generate_crash_dynamics()

# ==================== SENSOR FUSION ENGINE ====================
class SensorFusionEngine:
    """
    Edge AI processor that fuses multiple sensors and temporal history.
    Uses weighted scoring and simple rule-based temporal analysis.
    """
    def __init__(self, history_size: int = HISTORY_BUFFER_SIZE):
        self.history: deque[SensorData] = deque(maxlen=history_size)
        self.weights = {
            'acceleration': 0.25,
            'gyroscope': 0.20,
            'inclination': 0.15,
            'speed_change': 0.10,
            'airbag': 0.15,
            'driver_state': 0.10,
            'fire_smoke': 0.05,
        }

    def _analyze_speed_drop(self) -> float:
        """Calculate speed drop over the history buffer."""
        if len(self.history) < 2:
            return 0.0
        old_speed = self.history[0].gps_speed
        new_speed = self.history[-1].gps_speed
        return max(0, old_speed - new_speed)

    def _analyze_driver_state(self, data: SensorData) -> DriverState:
        """Use DMS data to determine driver state."""
        if data.ear < DROWSINESS_EAR_THRESHOLD and data.perclos > PERCLOS_THRESHOLD:
            return DriverState.UNCONSCIOUS
        if data.ear < 0.2 or data.perclos > 0.5:
            return DriverState.DROWSY
        if abs(data.head_pose_pitch) > 25 or abs(data.head_pose_yaw) > 45:
            return DriverState.DROWSY
        return DriverState.ALERT

    def calculate_confidence(self, data: SensorData) -> FusionResult:
        """Process a new sensor reading and return fusion result."""
        self.history.append(data)
        score = 0.0
        crash_detected = False
        rollover_detected = False
        fire_detected = False

        # 1. Acceleration magnitude
        accel_mag = (data.accel_x**2 + data.accel_y**2 + data.accel_z**2) ** 0.5
        if accel_mag > ACCEL_IMPACT_THRESHOLD:
            accel_score = min(100, (accel_mag - ACCEL_IMPACT_THRESHOLD) * 15 + 50)
            score += accel_score * self.weights['acceleration']
            crash_detected = True
        else:
            score += max(0, (accel_mag - 1.0) * 5) * self.weights['acceleration']

        # 2. Gyroscope
        gyro_mag = (data.gyro_x**2 + data.gyro_y**2 + data.gyro_z**2) ** 0.5
        if gyro_mag > GYRO_ROTATION_THRESHOLD:
            gyro_score = min(100, (gyro_mag - GYRO_ROTATION_THRESHOLD) * 0.3 + 50)
            score += gyro_score * self.weights['gyroscope']
            crash_detected = True
            if gyro_mag > 300 and data.inclination > 45:
                rollover_detected = True
        else:
            score += max(0, gyro_mag * 0.05) * self.weights['gyroscope']

        # 3. Inclination
        if data.inclination > INCLINE_ANGLE_THRESHOLD:
            incl_score = min(100, (data.inclination - INCLINE_ANGLE_THRESHOLD) * 2 + 50)
            score += incl_score * self.weights['inclination']
            crash_detected = True
            if data.inclination > 90:
                rollover_detected = True
        else:
            score += max(0, data.inclination * 0.2) * self.weights['inclination']

        # 4. Speed drop (temporal)
        speed_drop = self._analyze_speed_drop()
        if speed_drop > SPEED_SUDDEN_DROP_THRESHOLD:
            speed_score = min(100, (speed_drop - SPEED_SUDDEN_DROP_THRESHOLD) * 3 + 30)
            score += speed_score * self.weights['speed_change']
            crash_detected = True

        # 5. Airbag
        if data.airbag_deployed:
            score += 100 * self.weights['airbag']
            crash_detected = True

        # 6. Driver state
        driver_state = self._analyze_driver_state(data)
        if driver_state in [DriverState.UNCONSCIOUS, DriverState.UNRESPONSIVE]:
            score += 80 * self.weights['driver_state']
            crash_detected = True
        elif driver_state == DriverState.DROWSY:
            score += 30 * self.weights['driver_state']

        # 7. Fire/smoke
        if data.smoke_detected or data.cabin_temperature > 60:
            score += 90 * self.weights['fire_smoke']
            fire_detected = True
            crash_detected = True

        # Determine confidence level
        if score >= 80:
            confidence = ConfidenceLevel.CRITICAL
        elif score >= 60:
            confidence = ConfidenceLevel.HIGH
        elif score >= 40:
            confidence = ConfidenceLevel.MEDIUM
        else:
            confidence = ConfidenceLevel.LOW

        # Generate recommendation
        if confidence == ConfidenceLevel.CRITICAL:
            recommendation = "IMMEDIATE EMERGENCY DISPATCH - Severe crash, possible rollover/fire, driver unresponsive"
        elif confidence == ConfidenceLevel.HIGH:
            recommendation = "VERIFY DRIVER - High confidence crash, initiate verification protocol"
        elif confidence == ConfidenceLevel.MEDIUM:
            recommendation = "POSSIBLE CRASH - Monitor and verify driver status"
        else:
            recommendation = "LOG EVENT - No crash detected, continue monitoring"

        return FusionResult(
            confidence=confidence,
            confidence_score=score,
            crash_detected=crash_detected,
            rollover_detected=rollover_detected,
            fire_detected=fire_detected,
            driver_state=driver_state,
            impact_force_g=accel_mag,
            recommendation=recommendation
        )

# ==================== VERIFICATION PROTOCOL ====================
class VerificationProtocol:
    """Simulates the driver/rider verification countdown."""
    def __init__(self, window_seconds: int = VERIFICATION_WINDOW_SECONDS):
        self.window_seconds = window_seconds

    def verify_driver(self, driver_responsive: bool, simulated: bool = True) -> Tuple[bool, str]:
        """
        Run verification. If simulated=True, show countdown without actual delay.
        Returns (cancelled, status_string)
        """
        print(f"\n[VERIFICATION] 'ARE YOU SAFE?' - Press CANCEL if safe")
        print(f"[VERIFICATION] Countdown: {self.window_seconds} seconds")
        if not simulated:
            for i in range(self.window_seconds, 0, -1):
                print(f"  {i} seconds remaining...", end='\r')
                time.sleep(1)
            print("\n")
        else:
            print("  (simulation fast-forward)")

        if driver_responsive:
            print("[VERIFICATION] Driver pressed CANCEL - Event logged, returning to monitoring.")
            return True, "CANCELLED_BY_DRIVER"
        else:
            print("[VERIFICATION] No response - EMERGENCY CONFIRMED.")
            return False, "NO_RESPONSE"

# ==================== EMERGENCY DISPATCHER ====================
class EmergencyDispatcher:
    """Simulates emergency notification dispatch."""
    def dispatch(self, alert: EmergencyAlert) -> None:
        print("\n" + "="*60)
        print("🚨 EMERGENCY ALERT DISPATCHED")
        print("="*60)
        print(f"Vehicle ID:        {alert.vehicle_id}")
        print(f"Vehicle Type:      {alert.vehicle_type.value}")
        print(f"Location:          Lat {alert.location[0]:.6f}, Lon {alert.location[1]:.6f}")
        print(f"Timestamp:         {time.ctime(alert.timestamp)}")
        print(f"Confidence Level:  {alert.confidence.value}")
        print(f"Crash Signature:   {alert.crash_signature}")
        print(f"Occupant Status:   {alert.occupant_status}")
        print(f"Battery Status:    {alert.battery_status}")
        print("\nNotification Targets:")
        for target in alert.notification_targets:
            print(f"  ✓ {target}")
        print("="*60)

# ==================== POWERPOINT GENERATOR ====================
class PresentationGenerator:
    """Generates the AEGIS SENTINEL PowerPoint report."""
    def __init__(self, simulation_summary: Optional[Dict] = None):
        if not PPT_AVAILABLE:
            raise ImportError("python-pptx or matplotlib not installed. Run: pip install python-pptx matplotlib")
        self.prs = Presentation()
        self.prs.slide_width = Inches(10)
        self.prs.slide_height = Inches(7.5)
        self.sim_summary = simulation_summary or {}

        # Color palette
        self.BG = RGBColor(0x05, 0x08, 0x0F)
        self.PANEL = RGBColor(0x0A, 0x14, 0x1E)
        self.CYAN = RGBColor(0x00, 0xF0, 0xFF)
        self.GREEN = RGBColor(0x00, 0xFF, 0x88)
        self.AMBER = RGBColor(0xFF, 0xB3, 0x00)
        self.RED = RGBColor(0xFF, 0x00, 0x33)
        self.WHITE = RGBColor(0xE8, 0xF0, 0xFF)
        self.GRAY = RGBColor(0x6B, 0x7A, 0x8F)
        self.PURPLE = RGBColor(0xA8, 0x55, 0xF7)

    def _set_bg(self, slide):
        background = slide.background
        fill = background.fill
        fill.solid()
        fill.fore_color.rgb = self.BG

    def _add_title_bar(self, slide, title, subtitle=None):
        # Title
        box = slide.shapes.add_textbox(Inches(0.5), Inches(0.3), Inches(9), Inches(0.8))
        tf = box.text_frame
        tf.word_wrap = True
        p = tf.paragraphs[0]
        p.text = title
        p.font.size = Pt(28)
        p.font.bold = True
        p.font.color.rgb = self.CYAN
        p.font.name = "Montserrat"
        p.alignment = PP_ALIGN.LEFT
        # Subtitle
        if subtitle:
            sub = slide.shapes.add_textbox(Inches(0.5), Inches(1.0), Inches(9), Inches(0.5))
            stf = sub.text_frame
            stf.word_wrap = True
            sp = stf.paragraphs[0]
            sp.text = subtitle
            sp.font.size = Pt(14)
            sp.font.color.rgb = self.GRAY
            sp.font.name = "Roboto"

    def _add_panel(self, slide, left, top, width, height, fill=None, border=None):
        shape = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, left, top, width, height)
        shape.fill.solid()
        shape.fill.fore_color.rgb = fill or self.PANEL
        shape.line.color.rgb = border or self.CYAN
        shape.line.width = Pt(1.5)
        shape.adjustments[0] = 0.1
        return shape

    def _add_text_to_shape(self, shape, text, size=12, color=None, bold=False, align=PP_ALIGN.CENTER):
        tf = shape.text_frame
        tf.word_wrap = True
        p = tf.paragraphs[0]
        p.text = text
        p.font.size = Pt(size)
        p.font.color.rgb = color or self.WHITE
        p.font.bold = bold
        p.alignment = align
        tf.vertical_anchor = MSO_ANCHOR.MIDDLE

    def _add_bullet_text(self, slide, left, top, width, height, items, size=14, color=None, symbol="•"):
        box = slide.shapes.add_textbox(left, top, width, height)
        tf = box.text_frame
        tf.word_wrap = True
        for i, item in enumerate(items):
            p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
            p.text = f"{symbol} {item}"
            p.font.size = Pt(size)
            p.font.color.rgb = color or self.WHITE
            p.font.name = "Roboto"
            p.space_after = Pt(6)

    def _add_sensor_tag(self, slide, left, top, width, height, text, color=None):
        shape = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, left, top, width, height)
        shape.fill.solid()
        shape.fill.fore_color.rgb = RGBColor(0x0E, 0x1A, 0x28)
        shape.line.color.rgb = color or self.CYAN
        shape.line.width = Pt(1)
        shape.adjustments[0] = 0.5
        self._add_text_to_shape(shape, text, size=10, color=self.WHITE)
        return shape

    def _add_chart_image(self, slide, left, top, width, height, kind='gauge'):
        """Generate a matplotlib chart and insert as image."""
        fig, ax = plt.subplots(figsize=(5, 2.5), dpi=100)
        fig.patch.set_facecolor('#05080F')
        ax.set_facecolor('#0A141E')
        if kind == 'gauge':
            theta = np.linspace(0, np.pi, 100)
            r = 1.0
            x = r * np.cos(theta)
            y = r * np.sin(theta)
            ax.plot(x, y, color='#00F0FF', linewidth=2)
            ax.fill_between(x, y, 0, where=(y > 0), color='#00F0FF', alpha=0.1)
            ax.text(-0.8, 0.3, 'LOW', color='#FFB300', fontsize=9, fontweight='bold')
            ax.text(0, 0.6, 'MEDIUM', color='#FFB300', fontsize=9, fontweight='bold')
            ax.text(0.8, 0.3, 'CRITICAL', color='#FF0033', fontsize=9, fontweight='bold')
            score = self.sim_summary.get('confidence_score', 50)
            angle = np.pi * (1 - score/100)
            needle_x = 0.5 * np.cos(angle)
            needle_y = 0.5 * np.sin(angle)
            ax.annotate('', xy=(needle_x, needle_y), xytext=(0, 0),
                        arrowprops=dict(arrowstyle='->', color='#FF0033', lw=2))
            ax.set_xlim(-1.2, 1.2)
            ax.set_ylim(0, 1.2)
            ax.set_aspect('equal')
        ax.axis('off')
        buf = io.BytesIO()
        plt.savefig(buf, format='png', bbox_inches='tight', facecolor='#05080F', transparent=True)
        buf.seek(0)
        plt.close(fig)
        slide.shapes.add_picture(buf, left, top, width, height)

