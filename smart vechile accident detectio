# ==================== CONFIGURATION ====================
VERIFICATION_WINDOW_SECONDS = 20
HISTORY_BUFFER_SIZE = 10  # number of sensor samples for temporal analysis

# Thresholds
ACCEL_IMPACT_THRESHOLD = 4.0        # G
GYRO_ROTATION_THRESHOLD = 200       # deg/s
INCLINE_ANGLE_THRESHOLD = 60        # degrees
SPEED_SUDDEN_DROP_THRESHOLD = 30    # km/h drop within 0.5s
DROWSINESS_EAR_THRESHOLD = 0.15
PERCLOS_THRESHOLD = 0.7

# ==================== ENUMS ====================
class VehicleType(Enum):
    MOTORCYCLE = "Motorcycle"
    CAR = "Car"
    BUS = "Bus"
    TRUCK = "Truck"
    EV = "Electric Vehicle"
    AMBULANCE = "Ambulance"

class ConfidenceLevel(Enum):
    LOW = "LOW"
    MEDIUM = "MEDIUM"
    HIGH = "HIGH"
    CRITICAL = "CRITICAL"

class DriverState(Enum):
    ALERT = "ALERT"
    DROWSY = "DROWSY"
    UNCONSCIOUS = "UNCONSCIOUS"
    UNRESPONSIVE = "UNRESPONSIVE"

# ==================== DATA CLASSES ====================
@dataclass
class SensorData:
    timestamp: float
    accel_x: float
    accel_y: float
    accel_z: float
    gyro_x: float
    gyro_y: float
    gyro_z: float
    inclination: float
    gps_speed: float
    wheel_speed: float
    brake_active: bool
    steering_angle: float
    airbag_deployed: bool
    engine_status: bool
    battery_voltage: float
    cabin_temperature: float
    smoke_detected: bool
    ear: float  # Eye Aspect Ratio
    perclos: float
    head_pose_pitch: float
    head_pose_yaw: float
